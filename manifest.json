{
    "manifest_version": 3,
    "name": "Latexicus",
    "description": "Adds functionality to allow directly pasting Latex into Abicus",
    "version": "0.0.3",
    "permissions": [],
    "content_scripts": [
        {
            "matches": [
                "https://digabi.github.io/abicus/"
            ],
            "js": [
                "dist/content-bundle.js"
            ]
        }
    ],
    "action": {
        "default_popup": "dist/popup.html"
    },
    "icons": {
        "16": "assets/logo16.png",
        "32": "assets/logo32.png",
        "48": "assets/logo48.png",
        "128": "assets/logo128.png"
    }
}